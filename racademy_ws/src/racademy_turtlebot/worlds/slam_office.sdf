<?xml version="1.0" ?>
<!--
  SLAM Office World  —  12m x 10m indoor environment
  Layout:
    +============[door]============+
    |          Room 1 (top)        |
    +=[door]=+            +=[door]=+
    | Room 2 |   central  | Room 3 |
    +=[door]=+    area    +=[door]=+
    |          Room 4 (bot)        |
    +============[door]============+

  Rooms: ~5m x 3m each
  Central area: 6m x 4m with two distinctive pillars
  Obstacles: coloured boxes in each room
  Loop: drive through all 4 rooms for a full closure test
-->
<sdf version="1.6">
  <world name="slam_office">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         OUTER PERIMETER  —  12m wide (x: -6..6)  x  10m tall (y: -5..5)
         Wall thickness 0.2m, height 2.5m, z-center at 1.25m
         ================================================================ -->

    <model name="wall_north">
      <static>true</static><pose>0 5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>12.4 0.2 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>12.4 0.2 2.5</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static><pose>0 -5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>12.4 0.2 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>12.4 0.2 2.5</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static><pose>-6 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 10.4 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 10.4 2.5</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static><pose>6 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 10.4 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 10.4 2.5</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         HORIZONTAL DIVIDERS  (create top / central / bottom zones)
         North divider at y=2  —  door gap at x=-1..1  (2 m opening)
         South divider at y=-2  —  door gap at x=-1..1
         ================================================================ -->

    <!-- North divider — left of door (x: -6 .. -1) length=5, center=(-3.5, 2) -->
    <model name="div_north_left">
      <static>true</static><pose>-3.5 2 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>5.0 0.2 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>5.0 0.2 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- North divider — right of door (x: 1 .. 6) length=5, center=(3.5, 2) -->
    <model name="div_north_right">
      <static>true</static><pose>3.5 2 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>5.0 0.2 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>5.0 0.2 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South divider — left of door -->
    <model name="div_south_left">
      <static>true</static><pose>-3.5 -2 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>5.0 0.2 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>5.0 0.2 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South divider — right of door -->
    <model name="div_south_right">
      <static>true</static><pose>3.5 -2 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>5.0 0.2 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>5.0 0.2 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         VERTICAL DIVIDERS  (split central zone into left / center / right)
         West divider at x=-3  —  door gap at y=-0.8..0.8  (1.6 m opening)
         East divider at x=3   —  door gap at y=-0.8..0.8
         Only in the central band y=-2..2 (h=4m)
         ================================================================ -->

    <!-- West vertical divider — top half (y: 0.8..2) length=1.2, center=(-3, 1.4) -->
    <model name="div_west_top">
      <static>true</static><pose>-3 1.4 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 1.2 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 1.2 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West vertical divider — bottom half (y: -2..-0.8) length=1.2, center=(-3, -1.4) -->
    <model name="div_west_bottom">
      <static>true</static><pose>-3 -1.4 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 1.2 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 1.2 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East vertical divider — top half -->
    <model name="div_east_top">
      <static>true</static><pose>3 1.4 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 1.2 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 1.2 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East vertical divider — bottom half -->
    <model name="div_east_bottom">
      <static>true</static><pose>3 -1.4 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 1.2 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 1.2 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         OBSTACLES
         Two cylindrical pillars in the central area (loop-closure anchors)
         Coloured boxes in each of the four rooms
         ================================================================ -->

    <!-- Central pillars -->
    <model name="pillar_west">
      <static>true</static><pose>-1.5 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.15</radius><length>1.5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.15</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.4 0.4 0.8 1</ambient><diffuse>0.4 0.4 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_east">
      <static>true</static><pose>1.5 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.15</radius><length>1.5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.15</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.4 0.4 0.8 1</ambient><diffuse>0.4 0.4 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Room 1 (top): green boxes simulating furniture -->
    <model name="box_r1_a">
      <static>true</static><pose>-4 3.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.2 0.6 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.2 0.6 1.0</size></box></geometry>
          <material><ambient>0.3 0.6 0.3 1</ambient><diffuse>0.3 0.6 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_r1_b">
      <static>true</static><pose>2.5 3.5 0.5 0 0 0.5</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 1.0 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 1.0 1.0</size></box></geometry>
          <material><ambient>0.3 0.6 0.3 1</ambient><diffuse>0.3 0.6 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_r1_c">
      <static>true</static><pose>0 4.2 0.35 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.5 0.7</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.5 0.7</size></box></geometry>
          <material><ambient>0.3 0.6 0.3 1</ambient><diffuse>0.3 0.6 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Room 4 (bottom): red/orange boxes -->
    <model name="box_r4_a">
      <static>true</static><pose>-3.5 -3.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 0.8 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 0.8 1.0</size></box></geometry>
          <material><ambient>0.7 0.3 0.2 1</ambient><diffuse>0.7 0.3 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_r4_b">
      <static>true</static><pose>3.5 -3.5 0.5 0 0 0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.2 0.5 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.2 0.5 1.0</size></box></geometry>
          <material><ambient>0.7 0.3 0.2 1</ambient><diffuse>0.7 0.3 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_r4_c">
      <static>true</static><pose>0.5 -4.2 0.35 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 0.4 0.7</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.4 0.7</size></box></geometry>
          <material><ambient>0.7 0.3 0.2 1</ambient><diffuse>0.7 0.3 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Room 2 (left): yellow box -->
    <model name="box_r2">
      <static>true</static><pose>-4.5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 1.0 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 1.0 1.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.2 1</ambient><diffuse>0.7 0.7 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Room 3 (right): yellow box -->
    <model name="box_r3">
      <static>true</static><pose>4.5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 1.0 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 1.0 1.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.2 1</ambient><diffuse>0.7 0.7 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
